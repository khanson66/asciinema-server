<h2><a href={~p"/admin/users"}>Users</a> &rsaquo; New</h2>

<hr />
<br />

<.form :let={f} for={@changeset} action={~p"/admin/users"}>
  <p>
    <.label for={f[:email]}>Email</.label>
    <.input field={f[:email]} type="email" required />
    <.error field={f[:email]} />
  </p>

  <p>
    <.label for={f[:username]}>Username</.label>
    <.input field={f[:username]} required />
    <.error field={f[:username]} />
  </p>

  <p>
    <.label for={f[:password]}>Password</.label>
    <.input field={f[:password]} type="password" required />
    <.error field={f[:password]} />
  </p>

  <p>
    <.label for={f[:password_confirmation]}>Confirm Password</.label>
    <.input field={f[:password_confirmation]} type="password" required />
    <.error field={f[:password_confirmation]} />
  </p>

  <p>
    <button type="submit">Add</button>
  </p>
</.form>
